<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.GerenciarAtividadesPage"
             Title="Gerenciar Atividades">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="🎯 ATRIBUIR ATIVIDADE DE REFORÇO"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Aluno"/>

            <Picker x:Name="AlunoPicker"
                    Title="Selecione um aluno"/>

            <Label Text="Trilha"/>

            <Picker x:Name="TrilhaPicker"
                    Title="Selecione uma trilha"/>

            <Button Text="📚 Enviar Atividade"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnEnviarAtividadeClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>