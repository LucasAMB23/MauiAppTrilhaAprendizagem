<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.Aluno.ProgressoPage"
             Title="Meu Progresso">

    <!-- Retiramos o ScrollView externo para o CollectionView funcionar perfeitamente -->
    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="FillAndExpand">
        
        <!-- Parte do Progresso do Aluno-->
        <Label Text="📊 MEU PROGRESSO"
           FontSize="28"
           FontAttributes="Bold"
           HorizontalOptions="Center"
           TextColor="DarkBlue"/>

        <!-- Nome do aluno -->
        <Label Text="{Binding Nome}" 
               FontSize="24" 
               TextColor="DarkBlue" 
               HorizontalOptions="Center"/>

        <Frame BackgroundColor="#F0F8FF"
           Padding="15"
           CornerRadius="10">

            <VerticalStackLayout Spacing="10"
                                 HorizontalOptions="Center">

                <Label Text="{Binding PontuacaoTotal, StringFormat='🏆 Pontuação Total: {0} pontos'}"
                   FontSize="18"/>

                <Label Text="{Binding TotalAcertos, StringFormat='⭐ Total de Acertos: {0}'}"
                   FontSize="18"/>

                <Label Text="{Binding TotalTentativas, StringFormat='🔄 Total de Tentativas: {0}'}"
                   FontSize="18"/>

            </VerticalStackLayout>

        </Frame>

        <Label Text="✅ Trilhas"
           FontSize="20"
           FontAttributes="Bold"/>


        <Frame BackgroundColor="#F8F8F8" Padding="15" CornerRadius="10">
            <VerticalStackLayout Spacing="12">

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="✔" TextColor="Green" FontAttributes="Bold" FontSize="18" IsVisible="{Binding TrilhaNumerosConcluida}"/>
                    <Label Text="Trilha dos Números" FontSize="18" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="✔" TextColor="Green" FontAttributes="Bold" FontSize="18" IsVisible="{Binding TrilhaQuantidadesConcluida}"/>
                    <Label Text="Trilha das Quantidades" FontSize="18" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="✔" TextColor="Green" FontAttributes="Bold" FontSize="18" IsVisible="{Binding TrilhaCoresFormasConcluida}"/>
                    <Label Text="Trilha das Cores" FontSize="18" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="✔" TextColor="Green" FontAttributes="Bold" FontSize="18" IsVisible="{Binding TrilhaCoresFormasConcluida}"/>
                    <Label Text="Trilha das Formas" FontSize="18" VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>

















