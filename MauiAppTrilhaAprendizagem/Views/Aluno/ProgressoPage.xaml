<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTrilhaAprendizagem.Views.Aluno.ProgressoPage"
             Title="Meu Progresso">

    <!-- Retiramos o ScrollView externo para o CollectionView funcionar perfeitamente -->
    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="FillAndExpand">

        <!-- Nome do aluno -->
        <Label Text="{Binding Nome}" 
               FontSize="24" 
               TextColor="DarkBlue" 
               HorizontalOptions="Center"/>

        <!-- Bloco de Pontuação Total centralizado -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
            <Label Text="Pontuação Total:" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding PontuacaoTotal}" 
                   FontSize="20" 
                   FontAttributes="Bold"
                    TextColor="Green" />
        </HorizontalStackLayout>

        <Label Text="Exercícios Concluídos:" FontSize="18" Margin="0,10,0,0" />

        <!-- Lista de exercícios concluídos -->
        <CollectionView ItemsSource="{Binding Exercicios}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BackgroundColor="#F0F8FF" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}" FontSize="18" TextColor="Black" FontAttributes="Bold"/>

                            <!-- 🔧 Corrigido: Uso do StringFormat para juntar texto e Binding -->
                            <Label Text="{Binding Pontuacao, StringFormat='Pontuação: {0}'}" FontSize="16"/>
                            <Label Text="{Binding Tentativas, StringFormat='Tentativas: {0}'}" FontSize="16"/>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
































